{
  "name": "campusbridge",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "wrangler dev",
    "test": "node --test tests/*.test.mjs",
    "db:migrate": "wrangler d1 migrations apply campusbridge-portal-db --local",
    "db:seed": "node scripts/generate-seed.mjs && wrangler d1 execute campusbridge-portal-db --local --file scripts/seed.sql",
    "deploy": "npm run build && wrangler deploy",
    "deploy:live": "npm run build && wrangler deploy --env production",
    "db:migrate:live": "wrangler d1 migrations apply campusbridge-live-db --remote --env production"
  },
  "dependencies": {
    "@clerk/backend": "^3.23.0",
    "@clerk/react": "^6.17.6",
    "@phosphor-icons/react": "^2.1.10",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "wrangler": "^4.45.0"
  }
}
